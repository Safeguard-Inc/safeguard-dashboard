# ─────────────────────────────────────────────────────────────
# Safeguard Dashboard — Environment Configuration
# Copy this file to .env.local and configure for your deployment
# ─────────────────────────────────────────────────────────────

# URL of the Safeguard backend API service
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public Soroban RPC endpoint
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed SafeguardPayments contract address on Stellar Testnet
NEXT_PUBLIC_SAFEGUARD_PAYMENTS_CONTRACT_ID=CDC6KVX7QT7CD3GOVGX44NQUNS7FMSZKIAXTV3TDGSXQKJRQMDZRSRCN

# Stellar Network ("TESTNET" or "PUBLIC")
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
